From 5572550128f4b7739bd60b4f75481c22f32f76d9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 1 Aug 2026 07:27:18 +0000
Subject: [PATCH] Add central-api dual-write sync for 8 dropdown/master-data
 models

Same fix and reasoning as angroup's identical commit (kept in lockstep):
Unit, Currency, MaterialCategory, ProductCategory, CrmOptionList,
HsnTaxRate, Region, RegionTheme.
---
 src/models/CrmOptionList.ts    | 11 +++++++++++
 src/models/Currency.ts         | 11 +++++++++++
 src/models/HsnTaxRate.ts       | 11 +++++++++++
 src/models/MaterialCategory.ts | 11 +++++++++++
 src/models/ProductCategory.ts  | 11 +++++++++++
 src/models/Region.ts           | 11 +++++++++++
 src/models/RegionTheme.ts      | 11 +++++++++++
 src/models/Unit.ts             | 11 +++++++++++
 8 files changed, 88 insertions(+)

diff --git a/src/models/CrmOptionList.ts b/src/models/CrmOptionList.ts
index 66e3fba..2b8d7fa 100644
--- a/src/models/CrmOptionList.ts
+++ b/src/models/CrmOptionList.ts
@@ -7,6 +7,7 @@
  * near-identical collections -- same shape either way (code + label).
  */
 import mongoose, { Schema, Model, Document, Types } from "mongoose";
+import { syncRecordToCentralApi, deleteRecordFromCentralApi } from "@/lib/centralApiSync";
 
 export type CrmOptionListType = "APPOINTMENT_TYPE" | "REQUEST_TYPE";
 
@@ -36,6 +37,16 @@ const CrmOptionListSchema = new Schema<ICrmOptionList>(
 CrmOptionListSchema.index({ businessId: 1, listType: 1, isActive: 1 });
 CrmOptionListSchema.index({ businessId: 1, listType: 1, code: 1 }, { unique: true });
 
+CrmOptionListSchema.post("save", async function (doc) {
+  await syncRecordToCentralApi("crm_option_lists", doc._id.toString(), doc.toObject());
+});
+CrmOptionListSchema.post("findOneAndUpdate", async function (doc) {
+  if (doc) await syncRecordToCentralApi("crm_option_lists", doc._id.toString(), doc.toObject ? doc.toObject() : doc);
+});
+CrmOptionListSchema.post("findOneAndDelete", async function (doc) {
+  if (doc) await deleteRecordFromCentralApi("crm_option_lists", doc._id.toString());
+});
+
 const CrmOptionList: Model<ICrmOptionList> =
   (mongoose.models.CrmOptionList as Model<ICrmOptionList>) ||
   mongoose.model<ICrmOptionList>("CrmOptionList", CrmOptionListSchema);
