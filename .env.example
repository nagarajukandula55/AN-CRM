# MongoDB connection string.
MONGODB_URI=

# ===== central-api (shared pincode dataset) =====
# Base URL of central-api. Used by src/app/api/pincode/[pincode]/route.ts to
# look up state/district/city for a pincode from the shared dataset instead
# of each app maintaining its own seeded copy.
CENTRAL_API_URL=

# Site API key issued from central-api's admin dashboard (Sites tab), sent
# as the `x-api-key` header on every central-api request. Required for both
# the read (GET /api/v1/pincode?search=pincode:<value>) and the fallback
# write-back (POST /api/v1/pincode). The "pincode" data set must be
# registered in central-api first (admin dashboard -> Tables tab).
CENTRAL_API_KEY=
