# MongoDB connection string.
MONGODB_URI=

# ===== Razorpay (subscription checkout) =====
# From the Razorpay Dashboard > Settings > API Keys. Used by
# core/subscriptions/razorpayClient.ts to create orders (api/subscriptions/
# create-order) and verify the Checkout payment signature (api/subscriptions/
# verify). Neither route works without these set -- create-order throws,
# verify responds "Payment gateway not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay Dashboard > Settings > Webhooks, when creating a webhook
# pointed at <your-domain>/api/webhooks/razorpay with the "payment.captured"
# and "order.paid" events checked. A DIFFERENT secret from
# RAZORPAY_KEY_SECRET above -- this one verifies webhook deliveries, not
# Checkout's own signature. Optional: the webhook route no-ops (acks 200,
# does nothing) if this is unset, so the client-side verify() flow alone
# still works without it -- this is the server-side safety net for a
# payment that captured but whose browser never completed that call.
RAZORPAY_WEBHOOK_SECRET=

# ===== central-api (shared pincode dataset) =====
# Base URL of central-api. Used by src/app/api/pincode/[pincode]/route.ts to
# look up state/district/city for a pincode from the shared dataset instead
# of each app maintaining its own seeded copy.
CENTRAL_API_URL=

# Site API key issued from central-api's admin dashboard (Sites tab), sent
# as the `x-api-key` header on every central-api request. Required for both
# the read (GET /api/v1/pincode?search=pincode:<value>) and the fallback
# write-back (POST /api/v1/pincode). The "pincode" data set must be
# registered in central-api first (admin dashboard -> Tables tab).
CENTRAL_API_KEY=
